---
import { profile } from '../data/content';
---

<section id="contact" class="scroll-mt-16 pb-16 pt-24" aria-label="Contact">
  <div class="reveal rounded-3xl bg-ink p-8 text-paper sm:p-12">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] opacity-60">Contact</p>
    <h2 class="mt-3 font-serif text-3xl font-medium leading-tight sm:text-4xl">
      Hiring for product or consulting? Let's talk.
    </h2>
    <p class="mt-4 max-w-md opacity-70">
      I'm available for new grad roles starting 2026–27. The fastest way to reach me is email — I reply within a day.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={`mailto:${profile.email}`} class="inline-flex items-center gap-2 rounded-full bg-paper px-5 py-2.5 text-sm font-medium text-ink transition hover:-translate-y-0.5">
        {profile.email}
      </a>
      <button id="copy-email" type="button" data-email={profile.email} class="rounded-full border border-paper/25 px-5 py-2.5 text-sm font-medium transition hover:border-paper/60">
        Copy email
      </button>
      <a href={profile.resume} target="_blank" rel="noopener" class="rounded-full border border-paper/25 px-5 py-2.5 text-sm font-medium transition hover:border-paper/60">
        Résumé (PDF)
      </a>
    </div>
  </div>

  <footer class="mt-10 text-xs text-faint">
    © {new Date().getFullYear()} Akshita Choudhury · {profile.location}
  </footer>
</section>
