---
import { featured, projects } from '../data/content';
---

<section id="projects" class="scroll-mt-16 pt-24" aria-label="Projects">
  <p class="eyebrow">Projects</p>
  <h2 class="section-title">Things I've built on the side.</h2>

  <article class="reveal mt-8 overflow-hidden rounded-2xl border border-line bg-card">
    <div class="relative bg-black">
      <video
        class="aspect-video w-full"
        controls
        playsinline
        preload="none"
        poster={featured.poster}
        aria-label="Travelly prototype demo video"
      >
        <source src={featured.video} type="video/mp4" />
      </video>
    </div>

    <div class="p-6 sm:p-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h3 class="font-serif text-3xl font-medium text-ink">{featured.name}</h3>
          <p class="text-sm text-faint">{featured.kind}</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={featured.slides} target="_blank" rel="noopener" class="btn">
            View slides
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </a>
        </div>
      </div>

      <dl class="mt-6 space-y-4 text-sm leading-relaxed">
        {[['Problem', featured.problem], ['Solution', featured.solution], ['Process', featured.process]].map(([label, text]) => (
          <div class="grid gap-1 sm:grid-cols-[5.5rem_1fr] sm:gap-4">
            <dt class="pt-0.5 text-xs font-semibold uppercase tracking-wider text-accent">{label}</dt>
            <dd class="text-muted">{text}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-line pt-5">
        {featured.features.map((f) => <span class="rounded-full border border-line px-3 py-1 text-xs font-medium text-ink">{f}</span>)}
        <span class="mx-1 hidden h-4 w-px bg-line sm:block"></span>
        {featured.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>
  </article>

  <div class="dim-group mt-4 grid gap-4 sm:grid-cols-2">
    {projects.map((p) => (
      <a href={p.href} target="_blank" rel="noopener" class="dim-item reveal group flex flex-col rounded-2xl border border-line bg-card p-6 hover:-translate-y-1 hover:shadow-md">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="font-serif text-2xl font-medium text-ink">{p.name}</h3>
            <p class="text-sm text-faint">{p.kind}</p>
          </div>
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-muted transition group-hover:border-ink group-hover:bg-ink group-hover:text-paper">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
          </span>
        </div>
        <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">{p.description}</p>
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
          <ul class="flex flex-wrap gap-2">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
          <span class="text-xs font-medium text-accent">{p.linkLabel} →</span>
        </div>
      </a>
    ))}
  </div>
</section>
