---
import { profile } from '../data/content';

const links = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'recognition', label: 'Recognition' },
  { id: 'contact', label: 'Contact' },
];
---

<header class="pt-16 lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[44%] lg:flex-col lg:justify-between lg:py-20">
  <div>
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1 text-xs font-medium text-muted">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      Open to new grad Product &amp; Consulting roles
    </p>

    <h1 class="mt-6 font-serif text-5xl font-medium leading-[1.02] tracking-tight sm:text-6xl">
      Akshita<br />Choudhury
    </h1>
    <p class="mt-4 text-lg font-medium text-ink">
      Product builder at the intersection of <span class="text-accent">CS</span> and <span class="text-accent">business</span>.
    </p>
    <p class="mt-3 max-w-sm leading-relaxed text-muted">
      Waterloo Computer Science grad. I turn messy problems into shipped products — most recently AI workflows that took client onboarding from weeks to days.
    </p>

    <nav class="mt-14 hidden lg:block" aria-label="Sections">
      <ul>
        {links.map((l) => (
          <li>
            <a class="nav-link" href={`#${l.id}`} data-nav={l.id}>
              <span class="bar"></span>{l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="mt-10 lg:mt-0">
    <div class="flex flex-wrap gap-3">
      <a class="btn-primary" href={profile.resume} target="_blank" rel="noopener">
        View résumé
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
      <a class="btn" href={`mailto:${profile.email}`}>Get in touch</a>
    </div>

    <div class="mt-8 flex items-center gap-5 text-muted">
      <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="hover:text-ink">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
      </a>
      <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub" class="hover:text-ink">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0C17.3 4.97 18.3 5.3 18.3 5.3c.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .3"/></svg>
      </a>
      <a href={`mailto:${profile.email}`} aria-label="Email" class="hover:text-ink">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
      </a>
      <span class="h-5 w-px bg-line"></span>
      <button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="hover:text-ink">
        <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg class="block dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
  </div>
</header>
